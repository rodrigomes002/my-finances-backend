    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "MyFinancesApplication",
            "request": "launch",
            "mainClass": "com.myfinances.MyFinancesApplication",
            "projectName": "my-finances-backend",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bTomcat started on port\\(s\\): ([0-9]+)",
                "uriFormat": "http://localhost:%s/api/swagger-ui.html"
            }
        }
    ]
}